# ---------------------------------------------------------------------------
# Baseball Analytics Platform -- example environment.
# Copy to .env and fill in. NEVER commit a real .env.
# In production these are supplied by Google Secret Manager, not files.
# ---------------------------------------------------------------------------

# --- Core ---
BSA_ENV=development
BSA_LOG_LEVEL=INFO
BSA_API_PORT=8000

# --- Database ---
# docker compose default. For a host Postgres, point at your own instance.
BSA_DATABASE_URL=postgresql+psycopg://bsa:bsa@localhost:5433/bsa
BSA_TEST_DATABASE_URL=postgresql+psycopg://bsa:bsa@localhost:5433/bsa_test

# --- Object store (raw TrackMan source files) ---
# local | gcs
BSA_OBJECT_STORE_BACKEND=local
BSA_OBJECT_STORE_LOCAL_ROOT=./var/objectstore
# Only used when backend=gcs
BSA_GCS_BUCKET=

# --- Authentication ---
# local | passcode | dev | clerk
#   local    per-person accounts with a password, provisioned by the facility
#            from a TrackMan roster export. The real flow.
#   passcode one shared passcode per role. A demo gate: everyone holding it is
#            the same user, so nothing can be attributed to an individual.
#   dev      static seeded tokens. Refused outside BSA_ENV=development.
#   clerk    Phase 2+, not configured yet.
BSA_AUTH_PROVIDER=local

# Domain of the login addresses provisioning mints (first.last@<domain>).
BSA_ACCOUNT_EMAIL_DOMAIN=approach.com

# What an athlete must prove to claim the account provisioned for them.
#   open  a matching email address is enough
#   code  a matching address plus the activation code a coach hands out
# Addresses are derived from names, so "open" means whoever types the address
# first owns the account. Fine locally; a staging or production boot REFUSES to
# start unless this is set explicitly, so the choice is always deliberate.
BSA_SIGNUP_GATE=open

# How long a sign-in lasts, and how guessing is throttled.
BSA_SESSION_TTL_HOURS=12
BSA_LOGIN_MAX_ATTEMPTS=7
BSA_LOGIN_LOCKOUT_MINUTES=15

# Only read when BSA_AUTH_PROVIDER=passcode.
BSA_COACH_PASSCODE=coach
BSA_PLAYER_PASSCODE=player
# Clerk (Phase 2+). Secrets come from Secret Manager in production.
BSA_CLERK_JWKS_URL=
BSA_CLERK_ISSUER=
BSA_CLERK_AUDIENCE=

# --- Screenshot conversion ---
# vision | tesseract
#   vision     Apple Vision. macOS only, and the engine measured against real
#              TrackMan screenshots: 60 pitches, every readable value correct.
#              Needs the "macos" extra: uv pip install -e ".[macos]"
#   tesseract  Runs anywhere, including the container. Not measured against
#              real screenshots; expect more refusals to confirm by hand.
# There is no automatic fallback -- a silent downgrade would change how
# accurately athlete data is read without anyone choosing it.
BSA_OCR_ENGINE=vision

# --- TrackMan ---
# Not yet provisioned. Server-side only -- never expose to the browser.
BSA_TRACKMAN_PROVIDER=csv
BSA_TRACKMAN_FTP_HOST=
BSA_TRACKMAN_FTP_USER=
BSA_TRACKMAN_FTP_PASSWORD=
BSA_TRACKMAN_API_BASE_URL=
BSA_TRACKMAN_API_CLIENT_ID=
BSA_TRACKMAN_API_CLIENT_SECRET=

# --- The Futures App ---
# Integration method unconfirmed. Only "mock" and "manual" are implemented.
BSA_FUTURES_PROVIDER=manual

# --- Frontend (apps/web) ---
# NEXT_PUBLIC_* is shipped to the browser. Put NOTHING sensitive here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
