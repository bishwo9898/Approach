# ---------------------------------------------------------------------------
# Baseball Analytics Platform -- example environment.
# Copy to .env and fill in. NEVER commit a real .env.
# In production these are supplied by Google Secret Manager, not files.
# ---------------------------------------------------------------------------

# --- Core ---
BSA_ENV=development
BSA_LOG_LEVEL=INFO
BSA_API_PORT=8000

# --- Database ---
# docker compose default. For a host Postgres, point at your own instance.
BSA_DATABASE_URL=postgresql+psycopg://bsa:bsa@localhost:5433/bsa
BSA_TEST_DATABASE_URL=postgresql+psycopg://bsa:bsa@localhost:5433/bsa_test

# --- Object store (raw TrackMan source files) ---
# local | gcs
BSA_OBJECT_STORE_BACKEND=local
BSA_OBJECT_STORE_LOCAL_ROOT=./var/objectstore
# Only used when backend=gcs
BSA_GCS_BUCKET=

# --- Authentication ---
# dev | clerk
# "dev" uses static seeded tokens and is refused outside BSA_ENV=development.
BSA_AUTH_PROVIDER=dev
# Clerk (Phase 2+). Secrets come from Secret Manager in production.
BSA_CLERK_JWKS_URL=
BSA_CLERK_ISSUER=
BSA_CLERK_AUDIENCE=

# --- TrackMan ---
# Not yet provisioned. Server-side only -- never expose to the browser.
BSA_TRACKMAN_PROVIDER=csv
BSA_TRACKMAN_FTP_HOST=
BSA_TRACKMAN_FTP_USER=
BSA_TRACKMAN_FTP_PASSWORD=
BSA_TRACKMAN_API_BASE_URL=
BSA_TRACKMAN_API_CLIENT_ID=
BSA_TRACKMAN_API_CLIENT_SECRET=

# --- The Futures App ---
# Integration method unconfirmed. Only "mock" and "manual" are implemented.
BSA_FUTURES_PROVIDER=manual

# --- Frontend (apps/web) ---
# NEXT_PUBLIC_* is shipped to the browser. Put NOTHING sensitive here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
